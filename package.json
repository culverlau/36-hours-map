{
  "name": "36-hours-map",
  "version": "1.0.0",
  "description": "Interactive map of NYT 36 Hours travel articles",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fetch": "node scripts/fetch-articles.js",
    "fetch:recent": "node scripts/fetch-articles.js --recent",
    "build-data": "node scripts/build-data.js",
    "test": "node --test tests/",
    "restaurants:discover": "node scripts/restaurants/discover.js && node scripts/restaurants/curate.js",
    "restaurants": "node scripts/restaurants/fetch.js --refresh && node scripts/restaurants/build.js",
    "restaurants:update": "node scripts/restaurants/infatuation-sitemap.js && node scripts/restaurants/eater-sitemap.js --recent && node scripts/restaurants/curate.js && node scripts/restaurants/fetch.js && node scripts/restaurants/build.js"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "dotenv": "^16.4.5",
    "vite": "^5.4.0"
  },
  "keywords": [
    "nytimes",
    "travel",
    "map",
    "maplibre",
    "36-hours"
  ],
  "license": "MIT"
}
