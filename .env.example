# NYT Article Search API
# Get your key at: https://developer.nytimes.com/
NYT_API_KEY=your_nyt_api_key_here

# Google Geocoding API
# Enable at: https://console.cloud.google.com/apis/library/geocoding-backend.googleapis.com
GOOGLE_GEOCODING_KEY=your_google_geocoding_key_here

# LLM API (Optional - used as fallback for ambiguous locations)
# Only called when geocoding can't resolve a location
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here
